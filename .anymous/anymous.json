{
  "$schema": "https://anymous-cli.vercel.app/config.json",
  "model": "nvidia/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    },
    "question": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow",
    "todowrite": "allow"
  },
  "default_agent": "build",
  "skills": {
    "urls": ["https://anymous-cli.vercel.app/.well-known/skills/"]
  }
}