{
  "$schema": "https://anymous-cli.vercel.app/config.json",
  "model": "openrouter/~openai/gpt-mini-latest",
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    },
    "question": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow",
    "todowrite": "allow"
  },
  "default_agent": "build",
  "provider": {
    "openrouter": {
      "models": {
        "~openai/gpt-mini-latest": {
          "limit": { "context": 128000, "output": 1000 }
        }
      }
    }
  },
  "skills": {
    "urls": ["https://anymous-cli.vercel.app/.well-known/skills/"]
  }
}