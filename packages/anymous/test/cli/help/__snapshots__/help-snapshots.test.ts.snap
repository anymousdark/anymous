      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to ANYMOUS_SERVER_PASSWORD)
                                                                              [cadeia de caracteres]
  -u, --username      basic auth username (defaults to ANYMOUS_SERVER_USERNAME or 'anymous')
                                                                              [cadeia de caracteres]
      --mini          start the minimal interactive interface              [boolean] [padrão: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [número]"
