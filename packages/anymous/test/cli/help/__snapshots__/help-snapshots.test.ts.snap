exports[`anymous CLI help-text snapshots every documented command emits stable help text: anymous run --help 1`] = `
"anymous run [message..]

run Anymous with a message

Positionals:
  message  message to send                                                    [arranjo] [padrão: []]

Opções:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level   [cadeia de caracteres] [escolhas: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                 [cadeia de caracteres]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                   [cadeia de caracteres]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
      --share        share the session                                                     [boolean]
  -m, --model        model to use in the format of provider/model             [cadeia de caracteres]
      --agent        agent to use                                             [cadeia de caracteres]
      --format       format: default (formatted) or json (raw JSON events)
                            [cadeia de caracteres] [escolhas: "default", "json"] [padrão: "default"]
  -f, --file         file(s) to attach to message                                          [arranjo]
      --title        title for the session (uses truncated prompt if no value provided)
                                                                              [cadeia de caracteres]
      --attach       attach to a running Anymous server (e.g., http://localhost:4096)
                                                                              [cadeia de caracteres]
  -p, --password     basic auth password (defaults to ANYMOUS_SERVER_PASSWORD)[cadeia de caracteres]
  -u, --username     basic auth username (defaults to ANYMOUS_SERVER_USERNAME or 'anymous')
                                                                              [cadeia de caracteres]
      --dir          directory to run in, path on remote server if attaching  [cadeia de caracteres]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [número]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                              [cadeia de caracteres]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode           [boolean] [padrão: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                           [boolean] [padrão: false]"
`;

