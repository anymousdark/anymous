      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@hono/standard-validator": "0.2.0",
      "@kobalte/core": "0.13.11",
      "@lydell/node-pty": "1.2.0-beta.12",
      "@octokit/rest": "22.0.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@opentui/core": "0.4.5",
      "@opentui/keymap": "0.4.5",
      "@opentui/solid": "0.4.5",
      "@pierre/diffs": "1.2.10",
      "@playwright/test": "1.59.1",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "4.6.0",
      "@shikijs/stream": "4.2.0",
      "@solid-primitives/storage": "4.3.3",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@tailwindcss/vite": "4.1.11",
      "@tanstack/solid-virtual": "3.13.32",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "fuzzysort": "3.1.0",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "luxon": "3.6.1",
      "marked": "17.0.6",
      "marked-shiki": "1.2.1",
      "opentui-spinner": "0.0.7",
      "remeda": "2.26.0",
      "remend": "1.3.0",
      "shiki": "4.2.0",
      "solid-js": "1.9.10",
      "solid-list": "0.3.0",
      "sst": "4.13.1",
      "tailwindcss": "4.1.11",
      "typescript": "5.8.2",
      "ulid": "3.0.1",
      "vite": "7.1.4",
      "vite-plugin-solid": "2.11.10",
      "zod": "4.1.8"
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "bun run typecheck --cwd packages/anymous",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "build": "bun run script/build.ts --single --skip-install",
    "build:all": "bun run script/build.ts --skip-install",
    "prepare-npm": "bun run script/prepare-npm.ts",
    "dev": "bun dev",
    "dev:remote": "VITE_API_URL=https://anymous-cli.vercel.app bun dev",
    "clean": "rm -rf node_modules dist dist-npm .turbo *.tsbuildinfo packages/*/node_modules packages/*/dist packages/*/dist-npm packages/*/.turbo packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.x",
  "trustedDependencies": [
    "esbuild",
    "@lydell/node-pty",
    "protobufjs",
    "web-tree-sitter",
    "electron"
  ]
}
